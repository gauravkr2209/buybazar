# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/paisapath?schema=public
DATABASE_URL=

# Generate a long random secret (at least 32 characters) for Better Auth.
BETTER_AUTH_SECRET=
# Public origin used by Better Auth, e.g. http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Canonical public HTTPS site origin used by sitemap and robots metadata.
SITE_URL=

# Protects internal scheduled-price/alert jobs. Never expose this value in the browser.
CRON_SECRET=

# Provider credentials are intentionally not wired until the provider grants access
# and its current official API contract has been verified.
